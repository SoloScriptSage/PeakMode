{
  "name": "default",
  "windowsTweaks": true,
  "nvidiaTweaks": true,
  "interruptTweaks": false,

  "windows": {
    "targetProcess": "",
    "setProcPriorityHigh": true,
    "pinToPCores": true,
    "setUltimatePerf": true,
    "disableNagle": true,
    "disableSysMain": true,
    "disableSearchIndex": true,
    "setTimerResolution": false
  },

  "nvidia": {
    "maxPerfMode": true,
    "disableVSync": true,
    "disablePrerenderFrames": true,
    "threadedOptimization": true
  },

  "interrupt": {
    "nicInstanceId": "",
    "redirectNicIrq": true,
    "disableNicInterruptMod": true
  }
}
