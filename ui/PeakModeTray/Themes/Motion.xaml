<!-- Shared animations from the mockups' CSS keyframes. Views start them
     only when SystemParameters.ClientAreaAnimation is on ("Show
     animations" in Windows); the gauge's own motion lives in its control. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- pmPulse: opacity 1 -> .35 -> 1 over 0.7 s, ease-in-out (APPLYING tag, busy chip) -->
    <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                         Duration="0:0:0.35" AutoReverse="True">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- pmFlicker: opacity 1, .5 at 30 %, .95 at 45 %, .6 at 70 %, 1, linear, 0.35 s -->
    <Storyboard x:Key="FlickerStoryboard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.35">
            <LinearDoubleKeyFrame KeyTime="0:0:0"     Value="1" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.105" Value="0.5" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.1575" Value="0.95" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.245" Value="0.6" />
            <LinearDoubleKeyFrame KeyTime="0:0:0.35"  Value="1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

</ResourceDictionary>
