<!-- Design tokens from docs/design/DESIGN.md. Dark only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BgColor">#07080C</Color>
    <Color x:Key="DotColor">#1A1D27</Color>
    <Color x:Key="SidebarColor">#0B0C12</Color>
    <Color x:Key="SurfaceColor">#0D0F16</Color>
    <Color x:Key="SurfaceDimColor">#0A0B10</Color>
    <Color x:Key="SurfaceHotColor">#160B12</Color>
    <Color x:Key="SelectedColor">#1A0E16</Color>
    <Color x:Key="BorderColor">#1C1F2A</Color>
    <Color x:Key="BorderStrongColor">#2A2E3A</Color>
    <Color x:Key="BorderHotColor">#5A2140</Color>
    <Color x:Key="BorderOpenColor">#3A2030</Color>
    <Color x:Key="RowLineColor">#15171F</Color>
    <Color x:Key="TextColor">#F3F1EC</Color>
    <Color x:Key="TextSoftColor">#D6D3DE</Color>
    <Color x:Key="MutedColor">#A0A6AF</Color>
    <Color x:Key="FaintColor">#767D8D</Color>
    <Color x:Key="DisabledIconColor">#4A4F5C</Color>
    <Color x:Key="AccentColor">#FF3D7F</Color>
    <Color x:Key="AccentSoftColor">#FF8FB5</Color>
    <Color x:Key="AmberColor">#FFB020</Color>
    <Color x:Key="AmberBgColor">#1E1408</Color>
    <Color x:Key="AmberBorderColor">#5A4520</Color>
    <Color x:Key="AmberTextColor">#C9B48A</Color>
    <Color x:Key="GreenColor">#5BD18B</Color>
    <Color x:Key="GreenBorderColor">#1F3A2B</Color>
    <Color x:Key="OnAmberColor">#12141A</Color>
    <Color x:Key="HeatStartColor">#7C5CFF</Color>
    <Color x:Key="HeatEndColor">#FFB020</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush"           Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SidebarBrush"      Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceDimBrush"   Color="{StaticResource SurfaceDimColor}" />
    <SolidColorBrush x:Key="SurfaceHotBrush"   Color="{StaticResource SurfaceHotColor}" />
    <SolidColorBrush x:Key="SelectedBrush"     Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="BorderHotBrush"    Color="{StaticResource BorderHotColor}" />
    <SolidColorBrush x:Key="BorderOpenBrush"   Color="{StaticResource BorderOpenColor}" />
    <SolidColorBrush x:Key="RowLineBrush"      Color="{StaticResource RowLineColor}" />
    <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSoftBrush"     Color="{StaticResource TextSoftColor}" />
    <SolidColorBrush x:Key="MutedBrush"        Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush"        Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="DisabledIconBrush" Color="{StaticResource DisabledIconColor}" />
    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AmberBrush"        Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberBgBrush"      Color="{StaticResource AmberBgColor}" />
    <SolidColorBrush x:Key="AmberBorderBrush"  Color="{StaticResource AmberBorderColor}" />
    <SolidColorBrush x:Key="AmberTextBrush"    Color="{StaticResource AmberTextColor}" />
    <SolidColorBrush x:Key="GreenBrush"        Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenBorderBrush"  Color="{StaticResource GreenBorderColor}" />
    <SolidColorBrush x:Key="OnAmberBrush"      Color="{StaticResource OnAmberColor}" />

    <!-- Heat gradient: logo rim and redline only (in the logo's 100x100 space) -->
    <LinearGradientBrush x:Key="HeatBrush" MappingMode="Absolute" StartPoint="12,88" EndPoint="88,12">
        <GradientStop Offset="0"    Color="{StaticResource HeatStartColor}" />
        <GradientStop Offset="0.55" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1"    Color="{StaticResource HeatEndColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1C2030" />
        <GradientStop Offset="1" Color="#0A0B10" />
    </LinearGradientBrush>

    <!-- Window background: 1 px dots every 22 px -->
    <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,22,22" ViewportUnits="Absolute"
                  Viewbox="0,0,22,22" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BgBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,22,22" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource DotColor}" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="11,11" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Cut corner sizes (cards have a cut top-right, sometimes bottom-left) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CutSmall">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CutCard">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CutBanner">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CutPanel">22</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CutHero">28</sys:Double>

</ResourceDictionary>
