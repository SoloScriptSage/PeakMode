<Window x:Class="PeakModeTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PeakModeTray.Controls"
        xmlns:vm="clr-namespace:PeakModeTray.ViewModels"
        Title="PeakMode" Width="1180" Height="860" MinWidth="1100" MinHeight="720"
        Background="{StaticResource DotGridBrush}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        FocusManager.FocusedElement="{Binding ElementName=NavBoost}">
    <Window.Resources>
        <!-- Status tag on a module card -->
        <Style x:Key="StatusTagBorder" TargetType="Border" BasedOn="{StaticResource TagBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTagText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Module card: hot when applied, amber border while live, dim when skipped -->
        <Style x:Key="ModuleCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="c:CutCorners.TopRight" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHotBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderHotBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHotBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Included}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="c:CutCorners.TopRight" Value="14" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- History: session badge (CLEAN green, ACTIVE pink, others amber) -->
        <Style x:Key="SessionBadgeBorder" TargetType="Border" BasedOn="{StaticResource TagBorder}">
            <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeGreen}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GreenBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeHot}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderHotBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SessionBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeGreen}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeHot}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- History: one session in the list, accent border when selected -->
        <Style x:Key="SessionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="3,1,1,1" Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHotBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="StatTemplate" DataType="{x:Type vm:StatViewModel}">
            <Border Style="{StaticResource StatCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding Value}" Margin="0,3,0,2" FontSize="24" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValueText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hot}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="16,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <c:BoostGauge Width="40" Height="40" AnimationsOverride="False" IsHitTestVisible="False" />
                    <TextBlock Text="PEAKMODE" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="12" c:CutCorners.TopRight="12">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource MonoText}" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Free and open source. No account, no limits." Style="{StaticResource MutedText}"
                                   FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton x:Name="NavBoost" Style="{StaticResource NavItem}" Content="Boost" Tag="{x:Static vm:Icons.Boost}"
                                 IsChecked="True" GroupName="nav" AutomationProperties.Name="Boost"
                                 Checked="OnNavBoost" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Tweaks" Tag="{x:Static vm:Icons.Tweaks}"
                                 GroupName="nav" AutomationProperties.Name="Tweaks" Checked="OnNavTweaks" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Checkup" Tag="{x:Static vm:Icons.Checkup}"
                                 GroupName="nav" AutomationProperties.Name="PC Checkup" Checked="OnNavCheckup" />
                    <RadioButton Style="{StaticResource NavItem}" Content="History" Tag="{x:Static vm:Icons.History}"
                                 GroupName="nav" AutomationProperties.Name="History" Checked="OnNavHistory" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Settings" Tag="{x:Static vm:Icons.Settings}"
                                 GroupName="nav" AutomationProperties.Name="Settings" Checked="OnNavSettings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Boost screen -->
        <!-- Fits the window without scrolling (min size 1100 x 720): the hero
             row takes the free height up to 430 px, the rest goes to the
             spacer row at the bottom. -->
            <Grid x:Name="BoostPage" Grid.Column="1" Margin="36,24" DataContext="{Binding Boost}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="100*" MinHeight="180" MaxHeight="430" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Header -->
                <DockPanel Grid.Row="0">
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderStrongBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChipHot}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipAmber}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
                                        <Setter Property="Background" Value="{StaticResource AmberBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Chip}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChipHot}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChipAmber}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H1Text}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Hero + stats -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14"
                            c:CutCorners.TopRight="28" c:CutCorners.BottomLeft="28">
                        <!-- Gauge scales with the space it gets, up to 290 px. Counter
                             and hint go under it, or beside it when that gives a bigger
                             gauge (wide, short card); see OnHeroSizeChanged. -->
                        <Grid x:Name="HeroGrid" SizeChanged="OnHeroSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox x:Name="HeroGauge" MaxWidth="290" MaxHeight="290" Stretch="Uniform">
                                <Button Command="{Binding ToggleCommand}" Width="290" Height="290" Cursor="Hand"
                                        AutomationProperties.Name="{Binding HeroName}"
                                        FocusVisualStyle="{StaticResource AccentFocusVisual}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <c:BoostGauge Mode="{Binding Mode}" Progress="{Binding Progress}" />
                                </Button>
                            </Viewbox>
                            <StackPanel x:Name="HeroText" Grid.Row="1" Grid.ColumnSpan="2">
                            <StackPanel x:Name="CounterRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Count}" VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CounterText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CountHot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CountSuffix}" Style="{StaticResource LabelText}" FontSize="12"
                                           Margin="10,0,0,7" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="HintText" Text="{Binding Hint}" Style="{StaticResource MutedText}"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       MaxWidth="340" MinHeight="34" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Stretches to the hero's height; card content centered -->
                    <UniformGrid Grid.Column="2" Columns="2" Rows="2">
                        <UniformGrid.Resources>
                            <Style TargetType="ContentControl">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="ContentTemplate" Value="{StaticResource StatTemplate}" />
                            </Style>
                        </UniformGrid.Resources>
                        <ContentControl Content="{Binding ChangesStat}"  Margin="0,0,7,7" />
                        <ContentControl Content="{Binding SnapshotStat}" Margin="7,0,0,7" />
                        <ContentControl Content="{Binding PowerStat}"    Margin="0,7,7,0" />
                        <ContentControl Content="{Binding TimerStat}"    Margin="7,7,0,0" />
                    </UniformGrid>
                </Grid>

                <!-- Module cards -->
                <DockPanel Grid.Row="2" Margin="0,20,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="Change these on Tweaks" Style="{StaticResource MutedText}"
                               FontSize="12" VerticalAlignment="Bottom" />
                    <TextBlock Text="TWEAKS IN THIS PROFILE" Style="{StaticResource H2Text}" />
                </DockPanel>
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Modules}" Focusable="False" Margin="0,0,-12,-12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModuleCardViewModel}">
                            <Border Style="{StaticResource ModuleCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Data="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Included}" Value="False">
                                                            <Setter Property="Stroke" Value="{StaticResource DisabledIconBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHot}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}"
                                                   TextWrapping="Wrap" TextTrimming="None"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}" Margin="0,8,0,8"
                                               TextWrapping="Wrap" />
                                    <DockPanel>
                                        <!-- Read-only here; switches write the profile on Tweaks (commit 7) -->
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding Included, Mode=OneWay}" IsEnabled="False"
                                                      AutomationProperties.Name="{Binding SwitchName}"
                                                      AutomationProperties.ItemStatus="{Binding Status}"
                                                      AutomationProperties.HelpText="{Binding Detail}" />
                                    <WrapPanel>
                                        <Border Style="{StaticResource StatusTagBorder}" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTagText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagBorder}" BorderBrush="{StaticResource AmberBorderBrush}">
                                            <Border.Visibility>
                                                <Binding Path="ShowWarn">
                                                    <Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter>
                                                </Binding>
                                            </Border.Visibility>
                                            <TextBlock Text="NETWORK BLIP" Style="{StaticResource TagText}"
                                                       Foreground="{StaticResource AmberBrush}"
                                                       ToolTip="Drops the network for a few seconds" />
                                        </Border>
                                    </WrapPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        <!-- Tweaks screen: scrolls (thin dark scrollbar from the theme) -->
        <Grid x:Name="TweaksPage" Grid.Column="1" Margin="36,24,24,24" DataContext="{Binding Tweaks}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SelectedPillButton}" Content="{Binding ProfileName}" Focusable="False"
                            AutomationProperties.Name="Current profile" />
                    <Button Style="{StaticResource OutlineButton}" Content="+ NEW PROFILE" Margin="8,0,0,0"
                            IsEnabled="False" AutomationProperties.Name="New profile (not available yet)" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WHAT PEAKMODE CHANGES" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="TWEAKS" Style="{StaticResource H1Text}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,20,12,16">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,7,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ModulesOn}" Style="{StaticResource SummaryValueText}" />
                            <TextBlock Text="MODULES ON" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="7,0,7,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SettingsMax}" Style="{StaticResource SummaryValueText}"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="SETTINGS SAVED BEFORE BOOST (MAX)" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                                       Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="7,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding NetRestart}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryValueText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetRestartHot}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="NEED A NETWORK RESTART" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding StatusNote}" Style="{StaticResource FaintText}" Margin="0,10,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16,14" BorderThickness="1" c:CutCorners.TopRight="14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderOpenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Included}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource SurfaceDimBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Data="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Included}" Value="False">
                                                            <Setter Property="Stroke" Value="{StaticResource DisabledIconBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" Margin="12,0,0,0"
                                                      IsChecked="{Binding Included, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                                      AutomationProperties.Name="{Binding SwitchName}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Width="36" Height="36"
                                                Padding="0" Margin="12,0,0,0" Command="{Binding ToggleOpen}"
                                                AutomationProperties.Name="{Binding ExpandName}">
                                            <Path Data="M6 9l6 6 6-6" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2"
                                                  Stroke="{StaticResource MutedBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource MonoText}"
                                                   MinWidth="90" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource TagBorder}">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Warn}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Risk}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Warn}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}" FontSize="16" />
                                            <TextBlock Text="{Binding Desc}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            <!-- Opt-in rows (#9): one-line reason and a link to the issue -->
                                            <WrapPanel Margin="0,6,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource FaintText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource OutlineButton}" Padding="8,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Content="{Binding NoteLinkText}" Command="{Binding OpenNote}"
                                                        AutomationProperties.Name="{Binding OpenNoteName}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- Details -->
                                    <StackPanel Margin="0,14,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding K}" Style="{StaticResource MonoText}"
                                                                       Foreground="{StaticResource FaintBrush}" Width="80" />
                                                            <TextBlock Text="{Binding V}" Style="{StaticResource MonoText}"
                                                                       Foreground="{StaticResource TextSoftBrush}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <!-- Separate flags (rows with more than one) -->
                                        <ItemsControl ItemsSource="{Binding Flags}" Focusable="False" Margin="80,4,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFlags}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource SwitchToggle}"
                                                                      IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                                                      AutomationProperties.Name="{Binding SwitchName}" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}"
                                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Target process (process row) -->
                                        <StackPanel Margin="80,4,0,0" MaxWidth="360" HorizontalAlignment="Left">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTarget}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Target process" Style="{StaticResource MutedText}" FontSize="12" />
                                            <TextBox Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource InputBox}"
                                                     IsEnabled="{Binding CanEdit}" Width="320" HorizontalAlignment="Left"
                                                     Margin="0,6,0,0"
                                                     AutomationProperties.Name="Target process exe name, for example game.exe"
                                                     AutomationProperties.HelpText="{Binding TargetError}" />
                                            <TextBlock Text="{Binding TargetError}" Style="{StaticResource BodyText}" FontSize="12"
                                                       Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- PC Checkup screen: read-only checks with a status and a fix the user makes (docs/checkup.md) -->
        <Grid x:Name="CheckupPage" Grid.Column="1" Margin="36,24,24,24" DataContext="{Binding Checkup}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="RE-CHECK"
                        VerticalAlignment="Bottom" Command="{Binding RecheckCommand}"
                        AutomationProperties.Name="Run the checkup again" />
                <StackPanel>
                    <TextBlock Text="READ ONLY · NOTHING IS CHANGED" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="PC CHECKUP" Style="{StaticResource H1Text}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,20,12,16">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,7,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding OkCount}" Style="{StaticResource SummaryValueText}"
                                       Foreground="{StaticResource GreenBrush}" />
                            <TextBlock Text="OK" Style="{StaticResource LabelText}" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="7,0,7,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding WarnCount}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryValueText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarnHot}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="WORTH CHECKING" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="7,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding InfoCount}" Style="{StaticResource SummaryValueText}"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="INFO" Style="{StaticResource LabelText}" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                        </DockPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding CheckedText}" Style="{StaticResource FaintText}" Margin="0,10,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16,14" BorderThickness="1" c:CutCorners.TopRight="14"
                                    Background="{StaticResource SurfaceBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderOpenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Data="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Width="36" Height="36"
                                                Padding="0" Margin="12,0,0,0" Command="{Binding ToggleOpen}"
                                                AutomationProperties.Name="{Binding ExpandName}"
                                                AutomationProperties.HelpText="{Binding SpokenStatus}">
                                            <Path Data="M6 9l6 6 6-6" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2"
                                                  Stroke="{StaticResource MutedBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="8,4" MinWidth="118" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource TagBorder}">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource GreenBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Tag}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource TextBrush}" MinWidth="150" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}" FontSize="16" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- How to fix: always shown, it is the point of the row -->
                                    <Border Margin="0,12,0,0" Padding="12,10" BorderThickness="3,0,0,0"
                                            BorderBrush="{StaticResource AmberBrush}" Background="{StaticResource AmberBgBrush}"
                                            Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="HOW TO FIX" Style="{StaticResource LabelText}"
                                                       Foreground="{StaticResource AmberBrush}" Margin="0,1,10,0" />
                                            <TextBlock Text="{Binding Fix}" Style="{StaticResource BodyText}" FontSize="13"
                                                       Foreground="{StaticResource AmberTextBrush}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <!-- Details -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                        <Border Padding="12,10" BorderThickness="3,0,0,0" Margin="0,0,0,12"
                                                BorderBrush="{StaticResource BorderStrongBrush}" Background="{StaticResource SurfaceDimBrush}"
                                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding NoteLabel}" Style="{StaticResource LabelText}"
                                                           Margin="0,1,10,0" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="8,2"
                                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Content="{Binding LinkText}" Command="{Binding OpenLink}"
                                                        AutomationProperties.Name="{Binding LinkName}"
                                                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource BodyText}" FontSize="13"
                                                           Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding K}" Style="{StaticResource MonoText}"
                                                                       Foreground="{StaticResource FaintBrush}" Width="90" />
                                                            <TextBlock Text="{Binding V}" Style="{StaticResource MonoText}"
                                                                       Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- History screen: session list left, selected session right -->
        <Grid x:Name="HistoryPage" Grid.Column="1" Margin="36,24,24,24" DataContext="{Binding History}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="EVERY BOOST, EVERY RESTORE" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="HISTORY" Style="{StaticResource H1Text}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Restore-pending banner -->
            <Border Grid.Row="1" Margin="0,20,12,0" Padding="20,18" Background="{StaticResource AmberBgBrush}"
                    BorderBrush="{StaticResource AmberBorderBrush}" BorderThickness="1" c:CutCorners.TopRight="16"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12.01,18" Width="26" Height="26"
                          Stretch="Uniform" Stroke="{StaticResource AmberBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Later"
                            FontFamily="{StaticResource BodyFont}" FontSize="13" Margin="10,0,0,0"
                            Foreground="{StaticResource AmberTextBrush}" BorderBrush="{StaticResource AmberBorderBrush}"
                            Command="{Binding LaterCommand}" AutomationProperties.Name="Restore later" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource AmberButton}" Content="RESTORE NOW"
                            Command="{Binding RestoreNowCommand}" AutomationProperties.Name="Restore now" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PeakMode was still active when it last closed" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="The saved original settings are waiting to be restored." Style="{StaticResource BodyText}"
                                   FontSize="13" Foreground="{StaticResource AmberTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,20,12,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="No sessions yet. Every boost and restore shows up here."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="2" Margin="0,20,12,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SessionButton}" Command="{Binding Pick}"
                                        AutomationProperties.Name="{Binding AutomationName}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource SessionBadgeBorder}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Badge}" Style="{StaticResource SessionBadgeText}" />
                                            </Border>
                                            <TextBlock Text="{Binding When}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                       FontSize="16" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource MonoText}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="22" DataContext="{Binding Selected}" c:CutCorners.TopRight="22">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H2Text}" FontSize="22" />
                            <TextBlock Text="{Binding DetailMeta}" Style="{StaticResource MonoText}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,16,0,0">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE FOR" Style="{StaticResource LabelText}" FontSize="10" />
                                    <TextBlock Text="{Binding ActiveFor}" Style="{StaticResource StatValueText}" FontSize="18"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="RESTORED BY" Style="{StaticResource LabelText}" FontSize="10" />
                                    <TextBlock Text="{Binding RestoredBy}" Style="{StaticResource StatValueText}" FontSize="18"
                                               Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="{Binding RestoredBy}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="RESULT" Style="{StaticResource LabelText}" FontSize="10" />
                                    <TextBlock Text="{Binding Result}" FontSize="18" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValueText}">
                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultGood}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="0,0,0,6" Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="BEFORE → DURING" Style="{StaticResource LabelText}"
                                           FontSize="11" Foreground="{StaticResource FaintBrush}" />
                                <TextBlock Text="SNAPSHOT ENTRY" Style="{StaticResource LabelText}" FontSize="11"
                                           Foreground="{StaticResource FaintBrush}" />
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding EntriesNote}" Style="{StaticResource FaintText}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding N}" Style="{StaticResource MonoText}" FontSize="11"
                                                           Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding What}" Style="{StaticResource BodyText}" FontSize="13"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding What}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Before}" Style="{StaticResource MonoText}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="→" Foreground="{StaticResource FaintBrush}" Margin="8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding During}" Style="{StaticResource MonoText}" FontSize="12"
                                                           Foreground="{StaticResource AccentSoftBrush}" VerticalAlignment="Center" />
                                                <Path Grid.Column="5" Data="M5,12 L10,17 L20,7" Width="16" Height="16" Stretch="Uniform"
                                                      Stroke="{StaticResource GreenBrush}" StrokeThickness="2.5" HorizontalAlignment="Right"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      AutomationProperties.Name="Restored"
                                                      Visibility="{Binding Restored, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Settings screen: about, files, licenses -->
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Margin="36,24,24,24" DataContext="{Binding Settings}"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,12,0" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="ABOUT AND FILES" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="SETTINGS" Style="{StaticResource H1Text}" Margin="0,4,0,20" />

                <Border Style="{StaticResource StatCard}" Padding="20,16">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="GITHUB"
                                VerticalAlignment="Center" Command="{Binding OpenGitHubCommand}"
                                AutomationProperties.Name="Open the PeakMode project on GitHub" />
                        <StackPanel>
                            <TextBlock Text="VERSION" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource StatValueText}" FontSize="24" Margin="0,3,0,2" />
                            <TextBlock Text="Free and open source under the MIT license." Style="{StaticResource MutedText}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Padding="20,16" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="OPEN"
                                VerticalAlignment="Center" Command="{Binding OpenConfigCommand}"
                                AutomationProperties.Name="Open the config file" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="CONFIG" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding ConfigText}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextBrush}"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="The profile the Tweaks screen edits. Changes apply on the next boost."
                                       Style="{StaticResource MutedText}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Padding="20,16" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="OPEN"
                                VerticalAlignment="Center" Command="{Binding OpenLogCommand}"
                                AutomationProperties.Name="Open the log file" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="LOG" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource MonoText}" Foreground="{StaticResource TextBrush}"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="Written by the core on every boost and restore. Readable by administrators only."
                                       Style="{StaticResource MutedText}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="LICENSES" Style="{StaticResource H2Text}" Margin="0,28,0,12" />
                <ItemsControl ItemsSource="{Binding Licenses}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LicenseItem}">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="VIEW"
                                            Padding="12,6" Command="{Binding Open}"
                                            AutomationProperties.Name="{Binding AutomationName}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource MonoText}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource FaintText}" Margin="0,10,0,0"
                           Text="License files ship next to PeakModeTray.exe in the release zip. VIEW is off when a file is missing, as in a developer build." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
