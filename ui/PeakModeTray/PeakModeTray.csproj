<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\peakmode.ico</ApplicationIcon>
    <AssemblyName>PeakModeTray</AssemblyName>
    <RootNamespace>PeakModeTray</RootNamespace>
    <Version>0.1.0</Version>
    <Product>PeakMode</Product>
    <Copyright>Copyright (c) 2026 SoloScriptSage. MIT License.</Copyright>

    <!-- Release packaging: self-contained single exe for win-x64. The native
         PeakModeCore.dll and config stay as loose files next to it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>

    <!-- Where the CMake build put the core DLL (override with -p:CoreDllPath=...) -->
    <CoreDllPath Condition="'$(CoreDllPath)' == ''">..\..\core\build\Release\PeakModeCore.dll</CoreDllPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\peakmode.ico" LogicalName="PeakModeTray.peakmode.ico" />
    <InternalsVisibleTo Include="PeakModeTray.Tests" />
  </ItemGroup>

  <!-- Bundled OFL fonts (WPF resources). scripts/package.ps1 puts their
       licenses (Assets/Fonts/*-OFL.txt) in the release zip. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(CoreDllPath)" Link="PeakModeCore.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Condition="Exists('$(CoreDllPath)')" />
    <None Include="..\..\config\peakmode.json" Link="config\peakmode.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
